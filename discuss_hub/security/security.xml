<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <!-- Group used to grant access to Discuss Hub features -->
    <record id="group_discuss_hub_user" model="res.groups">
        <field name="name">Discuss Hub / Access</field>
    </record>

    <!-- Make administration users (base.group_system) also have Discuss Hub access by default -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_discuss_hub_user'))]" />
    </record>
</odoo>
